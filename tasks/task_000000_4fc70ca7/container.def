Bootstrap: localimage
From: /projects/bglk/myu8/endless-terminals/ubuntu_22.04.sif

%post
    # Install required packages
    apt-get update -y
    apt-get install -y rsync openssh-client python3-pip
    pip3 install pytest

    # Create home directory structure
    mkdir -p /home/user/backup-test
    chown -R 1000:1000 /home/user/backup-test
    chmod 755 /home/user/backup-test

    # Create required files with exact content
    echo "Sample data file 1" > /home/user/backup-test/file1.txt
    echo "Sample data file 2" > /home/user/backup-test/file2.txt
    echo "Backup operation log" > /home/user/backup-test/backup.log
    chown 1000:1000 /home/user/backup-test/*
    chmod 644 /home/user/backup-test/*

%environment
    # Set default environment variables
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export HOME=/home/user

%labels
    MAINTAINER "backup-operator@example.com"
    VERSION "1.0.0"